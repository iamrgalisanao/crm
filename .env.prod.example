# ---- Production env for docker-compose.prod.yml ----
# Copy to .env.prod and fill in. NEVER commit .env.prod.

# Public URL of the deployment (used for CORS, cookies, and the web→API base).
CRM_DOMAIN=crm.abbadev.com
PUBLIC_URL=https://crm.abbadev.com

# Database password (use a long random string).
POSTGRES_PASSWORD=change-me-strong-db-password

# Auth secrets — generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-64-hex
JWT_REFRESH_SECRET=change-me-refresh-secret-64-hex

# Seed super admin (created on first `db:seed`). For a public DEMO, keep these
# obvious; for a real deployment, use a strong password and change it after login.
SEED_ORG_NAME=abbadev CRM Demo
SEED_ADMIN_EMAIL=demo@abbadev.com
SEED_ADMIN_PASSWORD=DemoPass123!
SEED_BASE_CURRENCY=PHP

# Public interactive DEMO login (created by the demo seed / nightly reset).
# Sales Manager + Finance — can drive the whole flow, but not users/settings.
SEED_DEMO_EMAIL=guest@abbadev.com
SEED_DEMO_PASSWORD=GuestDemo123!

# Optional: enable the Claude AI provider (leave blank for the heuristic engine).
ANTHROPIC_API_KEY=

# Only for docker-compose.registry.yml (pull prebuilt images from GHCR).
# Your GitHub username/org, lowercase. e.g. abbadev
GHCR_OWNER=your-github-username
