# Single-domain reverse proxy with automatic HTTPS (Let's Encrypt).
# The domain is injected from the CRM_DOMAIN env var (set in .env.prod).
{$CRM_DOMAIN} {
	encode zstd gzip

	# API (NestJS serves under the /api prefix) — same domain, so refresh
	# cookies are first-party and there are no CORS problems.
	handle /api/* {
		reverse_proxy api:4000
	}

	# Everything else → the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
